{
  "name": "@polis/react",
  "version": "0.1.0",
  "description": "Shared React core for Polis-family apps (auth, API client, base contexts, layout primitives, reusable components).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PomeloProductions/polis-react.git"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "polis",
    "react",
    "components",
    "mantine",
    "bootstrap"
  ],
  "type": "module",
  "main": "src/index.ts",
