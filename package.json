{
  "name": "@polis/react",
  "version": "0.1.0",
  "description": "Shared React core for Polis-family apps (auth, API client, base contexts, layout primitives, reusable components).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",

    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*/index.tsx",

    "./contexts": "./src/contexts/index.ts",
    "./contexts/*": "./src/contexts/*.tsx",

    "./services": "./src/services/index.ts",
    "./services/*": "./src/services/*.ts",

    "./util": "./src/util/index.ts",
    "./util/*": "./src/util/*.ts",

    "./models": "./src/models/index.ts",
    "./models/*": "./src/models/*.ts",

    "./data/*": "./src/data/*.ts",

    "./components/PolisProvider": "./src/components/PolisProvider/index.tsx",
    "./theme": "./src/theme/index.ts",
    "./theme/PolisTheme": "./src/theme/PolisTheme.ts",
    "./theme/PolisThemeContext": "./src/theme/PolisThemeContext.tsx",
    "./theme/*": "./src/theme/*.scss",

    "./assets/*": "./src/assets/*",

    "./pages/*": "./src/pages/*/index.tsx",

    "./pages/DynamicPage": "./src/pages/DynamicPage/index.tsx",
    "./pages/Browse/CategoryEditor": "./src/pages/Browse/CategoryEditor/index.tsx",
    "./pages/ComponentGuide": "./src/pages/ComponentGuide/index.ts",
    "./pages/ComponentGuide/ComponentGuideOverview": "./src/pages/ComponentGuide/ComponentGuideOverview.tsx",
    "./pages/ComponentGuide/ComponentsIndex": "./src/pages/ComponentGuide/ComponentsIndex.tsx",
    "./pages/ComponentGuide/ComponentDetail": "./src/pages/ComponentGuide/ComponentDetail.tsx",
    "./pages/ComponentGuide/ComponentPlayground": "./src/pages/ComponentGuide/ComponentPlayground.tsx",
    "./pages/ComponentGuide/AddToPageModal": "./src/pages/ComponentGuide/AddToPageModal.tsx",
    "./pages/ComponentGuide/ConfigEditor": "./src/pages/ComponentGuide/ConfigEditor.tsx",
    "./pages/ComponentGuide/componentMetadata": "./src/pages/ComponentGuide/componentMetadata.ts",

    "./components/Templates/TemplateList": "./src/components/Templates/TemplateList/index.tsx",
    "./components/Templates/TemplateEditor": "./src/components/Templates/TemplateEditor/index.tsx",
    "./pages/Admin/Templates": "./src/pages/Admin/Templates/index.tsx",
    "./services/MessagingTemplateRequests": "./src/services/requests/MessagingTemplateRequests.ts",
    "./models/messaging-template": "./src/models/messaging-template.ts",
    "./util/template-interpolate": "./src/util/template-interpolate.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --reporters=default --reporters=github-actions",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --ci --coverage --coverageReporters=lcov --coverageReporters=text --coverageReporters=json-summary"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/core": "^7.17.8",
    "@mantine/dates": "^7.17.8",
    "@mantine/dropzone": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@mantine/tiptap": "^7.17.8",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@uiw/react-md-editor": "^4.0.11",
    "axios": "^1.13.5",
    "bootstrap": "^5.3.8",
    "formik": "^2.4.9",
    "moment": "^2.30.1",
    "react-bootstrap": "^2.10.5",
    "react-helmet": "^6.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.3",
    "sass": "^1.97.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-helmet": "^6.1.11",
    "@types/redux-mock-store": "^1.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "redux-mock-store": "^1.5.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
